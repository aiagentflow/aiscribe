{
  "name": "aiscribe",
  "version": "1.2.23",
  "description": "Your AI's scribe. Every session, recorded, traceable, backed up. One command journals git diffs and full AI conversations into a searchable log, links every change back to the chat that caused it, and auto-pushes to a private GitHub repo.",
  "main": "dist/index.js",
  "bin": {
    "aiscribe": "dist/index.js"
  },
  "homepage": "https://aiagentflow.dev/aiscribe",
  "bugs": {
    "url": "https://github.com/aiagentflow/aiscribe/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai",
    "session",
    "journal",
    "git",
    "scribe",
    "memory",
    "backup",
    "github",
    "claude-code",
    "cursor",
    "codex",
    "pi"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiagentflow/aiscribe.git"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.11.3",
    "simple-git": "^3.27.0",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/tar-stream": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
